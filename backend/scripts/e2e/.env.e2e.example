# E2E harness environment — EXAMPLE ONLY.
#
# Copy this OUTSIDE the repository, fill it in there, and pass it with
# --env-file. Never commit a filled-in copy. Every value below is a placeholder
# and the harness will refuse to run until each is replaced.
#
#   cp backend/scripts/e2e/.env.e2e.example /secure/path/e2e.env
#   chmod 600 /secure/path/e2e.env
#
# The harness reads the environment first, then this file. It never reads the
# application's own .env / .env.production — and refuses if you point it at one.

# --- Target ----------------------------------------------------------------
# Production targets must be HTTPS and on the allowed-host list.
E2E_API_BASE_URL=https://api.hiddenalerts.com
E2E_TARGET_ENV=production

# Comma-separated override for the allowed production hosts. Only set this if
# you genuinely mean to target somewhere else.
# E2E_ALLOWED_HOSTS=api.hiddenalerts.com,hiddenalerts.com

# --- Internal JWT admin (POST /api/v1/auth/login, JSON email+password) ------
# Aliases accepted: E2E_ADMIN_EMAIL / E2E_ADMIN_USERNAME, E2E_ADMIN_PASSWORD.
ADMIN_EMAIL=changeme@example.com
ADMIN_PASSWORD=changeme

# --- Supabase subscriber (password grant) -----------------------------------
# Must be an account with an ACTIVE subscription.
# Aliases accepted: E2E_SUBSCRIBER_EMAIL / E2E_SUBSCRIBER_PASSWORD.
TEST_SUBSCRIBER_EMAIL=changeme@example.com
TEST_SUBSCRIBER_PASSWORD=changeme

# Supabase project. Use the PUBLISHABLE (anon) key.
# The harness inspects this key and REFUSES a service-role key.
# Aliases accepted: SUPABASE_URL, SUPABASE_ANON_KEY.
SUPABASE_PROJECT_URL=https://changeme.supabase.co
SUPABASE_PUBLISHABLE_KEY=changeme

# --- Optional: inactive subscriber, for the negative subscription test ------
# When set, the smoke runner asserts this account gets 403
# active_subscription_required rather than 401. Without it, that check is
# reported as skipped.
# TEST_INACTIVE_SUBSCRIBER_EMAIL=
# TEST_INACTIVE_SUBSCRIBER_PASSWORD=

# --- Optional tuning --------------------------------------------------------
# E2E_REQUEST_TIMEOUT_SECONDS=30
# E2E_POLL_INTERVAL_SECONDS=5
# E2E_RUN_TIMEOUT_SECONDS=900
# E2E_REPORT_DIR=backend/reports
