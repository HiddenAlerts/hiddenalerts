# ─── Database ─────────────────────────────────────────────────────────────────
# These three are read by the 'db' container to create the database.
# The DATABASE_URL uses 'hiddenalerts_db' (container name), not localhost.
POSTGRES_USER=hiddenalerts
POSTGRES_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD
POSTGRES_DB=hiddenalerts

DATABASE_URL=postgresql+asyncpg://hiddenalerts:CHANGE_TO_A_STRONG_PASSWORD@hiddenalerts_db:5432/hiddenalerts
DATABASE_URL_SYNC=postgresql://hiddenalerts:CHANGE_TO_A_STRONG_PASSWORD@hiddenalerts_db:5432/hiddenalerts

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Root directory for uploaded media (served at /uploads). Must match the
# container side of the uploads bind mount in docker-compose.yml
# (/opt/hiddenalerts/uploads:/app/uploads).
UPLOAD_DIR=/app/uploads

# ─── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=6
DEFAULT_POLLING_MINUTES=60

# ─── AI — fill in for Milestone 2 ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Email — fill in for Milestone 3 ──────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENTS=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Canonical production frontend URL. Used as a fallback base for the Stripe
# redirect URLs below when those are unset.
FRONTEND_BASE_URL=https://hiddenalerts.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated exact origins allowed to make cross-origin requests. Takes
# precedence over FRONTEND_BASE_URL for CORS purposes only. Include
# http://localhost:3000 only if the deployment must also serve local frontend
# development directly.
CORS_ALLOWED_ORIGINS=https://hiddenalerts.com,http://localhost:3000

# ─── Stripe redirect URLs ───────────────────────────────────────────────────
# Where Stripe sends the browser back to after Checkout / the Customer
# Portal. Paths must match real frontend routes: /dashboard (post-checkout
# success), /subscribe (the plan-selection page — used on cancel), /settings
# (the Billing tab lives here — used on portal return). Neither /pricing nor
# /account exists as a route in the current frontend; do not use them.
STRIPE_CHECKOUT_SUCCESS_URL=https://hiddenalerts.com/dashboard
STRIPE_CHECKOUT_CANCEL_URL=https://hiddenalerts.com/subscribe
STRIPE_PORTAL_RETURN_URL=https://hiddenalerts.com/settings
